{
  "name": "01-Notificacion-Biblioteca-Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "biblioteca-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "webhook-biblioteca-001",
      "name": "Webhook Biblioteca",
      "webhookId": "biblioteca-webhook-001"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "check-evento",
              "leftValue": "={{ $json.body.evento }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "check-data",
              "leftValue": "={{ $json.body.data }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [220, 0],
      "id": "if-validation",
      "name": "Validar Evento"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-eventType",
              "name": "eventType",
              "value": "={{ $json.body.evento }}",
              "type": "string"
            },
            {
              "id": "field-timestamp",
              "name": "timestamp",
              "value": "={{ $json.body.timestamp }}",
              "type": "string"
            },
            {
              "id": "field-prestamoId",
              "name": "prestamoId",
              "value": "={{ $json.body.data.id || $json.body.data.prestamoId }}",
              "type": "string"
            },
            {
              "id": "field-libro",
              "name": "libroTitulo",
              "value": "={{ $json.body.data.libroTitulo || $json.body.data.titulo }}",
              "type": "string"
            },
            {
              "id": "field-usuario",
              "name": "usuario",
              "value": "={{ $json.body.data.usuario || $json.body.data.nombreUsuario }}",
              "type": "string"
            },
            {
              "id": "field-fechaDevolucion",
              "name": "fechaDevolucion",
              "value": "={{ $json.body.data.fechaDevolucion }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, -100],
      "id": "transform-data",
      "name": "Transformar Datos"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "TU_API_KEY_AQUI"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Genera un mensaje de notificación profesional en español para esta operación de biblioteca:\\n\\nEvento: {{ $json.eventType }}\\nLibro: {{ $json.libroTitulo }}\\nUsuario: {{ $json.usuario }}\\nFecha Devolución: {{ $json.fechaDevolucion }}\\n\\nCrea un mensaje breve (2-3 oraciones) y amigable. Incluye emojis apropiados según el tipo de evento.\"\n    }]\n  }]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [660, -100],
      "id": "gemini-request",
      "name": "Gemini IA"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "extract-ai-message",
              "name": "aiMessage",
              "value": "={{ $json.candidates[0].content.parts[0].text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, -100],
      "id": "extract-message",
      "name": "Extraer Mensaje IA"
    },
    {
      "parameters": {
        "chatId": "TU_CHAT_ID_AQUI",
        "text": "=📚 *BIBLIOTECA - NOTIFICACIÓN*\\n\\n{{ $json.aiMessage }}\\n\\n🕐 Hora: {{ $('Transformar Datos').item.json.timestamp }}\\n📖 Libro: {{ $('Transformar Datos').item.json.libroTitulo }}\\n👤 Usuario: {{ $('Transformar Datos').item.json.usuario }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1100, -100],
      "id": "telegram-notify",
      "name": "Enviar Telegram",
      "webhookId": "telegram-bot-webhook",
      "credentials": {}
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"received\",\n  \"message\": \"Event processed successfully\",\n  \"workflow\": \"notification\",\n  \"evento\": \"{{ $('Transformar Datos').item.json.eventType }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1320, 0],
      "id": "respond-webhook",
      "name": "Responder al Backend"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"error\",\n  \"message\": \"Invalid event structure\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [440, 150],
      "id": "respond-error",
      "name": "Responder Error"
    }
  ],
  "connections": {
    "Webhook Biblioteca": {
      "main": [[{ "node": "Validar Evento", "type": "main", "index": 0 }]]
    },
    "Validar Evento": {
      "main": [
        [{ "node": "Transformar Datos", "type": "main", "index": 0 }],
        [{ "node": "Responder Error", "type": "main", "index": 0 }]
      ]
    },
    "Transformar Datos": {
      "main": [[{ "node": "Gemini IA", "type": "main", "index": 0 }]]
    },
    "Gemini IA": {
      "main": [[{ "node": "Extraer Mensaje IA", "type": "main", "index": 0 }]]
    },
    "Extraer Mensaje IA": {
      "main": [[{ "node": "Enviar Telegram", "type": "main", "index": 0 }]]
    },
    "Enviar Telegram": {
      "main": [[{ "node": "Responder al Backend", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
