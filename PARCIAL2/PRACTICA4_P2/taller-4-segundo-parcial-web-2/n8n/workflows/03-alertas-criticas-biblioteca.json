    "Log - Media Urgencia": {
      "main": [[{ "node": "Responder al Backend", "type": "main", "index": 0 }]]
    },
    "Log - Baja Urgencia": {
      "main": [[{ "node": "Responder al Backend", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
